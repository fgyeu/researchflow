# ============================================================
# ResearchFlow 配置模板
#
# 用法：把本文件复制成 .env（同目录），然后填上你的 key。
#       .env 已经在 .gitignore 里，不会被推到 GitHub。
#
#   cp .env.example .env
# ============================================================

# ---- 模型 API ----
# 任何兼容 OpenAI /chat/completions 协议的服务都能用。
# 下面给几个常见选择，取消注释其中一组即可。

# DeepSeek（便宜，中文好，推荐入门用）
LLM_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 阿里云百炼 / 通义
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 智谱
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 本地 vLLM（阶段 3 可能用到）
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen2.5-7B-Instruct

# ---- 离线模式 ----
# 设成 1 就完全不联网、不花钱，用预设脚本模拟模型。
# 跑测试、做故障注入实验、演示链路时用它。
# MOCK_LLM=1

# ---- 运行约束（面试会问：为什么要限制？）----
# 最多想几步。太高会烧钱，太低研究不深入。8 是经验值。
AGENT_MAX_STEPS=8

# 单次研究最多用多少 token。超了会触发"强制收尾"，而不是直接失败。
AGENT_MAX_TOKENS=20000

# 单次模型调用超时（秒）
LLM_TIMEOUT=60

# 单次工具调用超时（秒）
TOOL_TIMEOUT=20